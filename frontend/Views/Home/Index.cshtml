@model VernonFanSite.Models.HomeViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Vernon Archive";
    Layout = "_Layout";
    var assetBase = Configuration["AssetBaseUrl"]?.TrimEnd('/') ?? "";
}

<div class="row align-items-center" style="min-height:80vh;">
    <div class="col-lg-6">
        <h1 class="hero-title">HANSOL<br>VERNON<br>CHWE.</h1>
        <p class="hero-subtitle">Artist. Rapper. Visual. / The complete archive.</p>

        <div class="d-grid gap-3 mt-5">
            <button class="feature-btn" data-bs-toggle="modal" data-bs-target="#factsModal">
                <i class="bi bi-info-circle"></i> Profile & Facts
            </button>

            <button class="feature-btn" data-bs-toggle="modal" data-bs-target="#discographyModal">
                <i class="bi bi-disc"></i> Discography
            </button>

            <button class="feature-btn" data-bs-toggle="modal" data-bs-target="#messagesModal">
                <i class="bi bi-chat-left-heart"></i> Fan Messages
            </button>
        </div>
    </div>
    <div class="col-lg-6 d-none d-lg-block text-end">
        <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/vernon/kpoppapi.jpg") : assetBase + "/images/vernon/kpoppapi.jpg")" class="img-fluid" style="filter: grayscale(100%); max-height:700px; object-fit: cover;" alt="Vernon">
    </div>
</div>


<div class="modal fade" id="factsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="section-title mb-0">Profile & Facts</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-4 text-center mb-4 mb-md-0">
                        <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/vernon/kpoppapi.jpg") : assetBase + "/images/vernon/kpoppapi.jpg")" class="img-fluid rounded-circle mb-3" style="width:150px; filter: grayscale(100%);" alt="Profile">
                        <h4>Vernon</h4>
                        <p class="text-muted">SEVENTEEN / Hip-Hop Team</p>
                    </div>
                    <div class="col-md-8">
                        <ul class="list-unstyled">
                            @foreach (var fact in Model.FunFacts)
                            {
                                <li class="fact-item"><i class="bi bi-dot"></i> @fact</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="galleryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-white border-0">

            <div class="modal-header border-0 justify-content-center position-relative py-4">
                <h2 class="section-title mb-0 fw-black text-center" style="letter-spacing: -1px; font-size:2.5rem;">
                    ✨ THE "HAPPY VIBES" COLLECTION ✨
                </h2>
                <button type="button" class="btn-close position-absolute top-50 end-0 translate-middle-y me-4" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body pt-0 px-4 px-md-5" style="max-height:75vh; overflow-y: auto;">

                <p class="text-center text-muted fs-5 mb-5" style="max-width:600px; margin-inline: auto;">
                    A curated selection of Vernon's best moments in full, vibrant color. Instant serotonin boost guaranteed! ☀️
                </p>

                <div class="gallery-grid surprise-gallery pb-4">
                    @for (int i =1; i <=15; i++)
                    {
                        <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content($"~/images/vernon/vernon{ i }.jpg") : assetBase + $"/images/vernon/vernon{ i }.jpg")" class="gallery-img" alt="Vernon Photo @i" onerror="this.style.display='none'">
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="messagesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <ul class="nav nav-tabs w-100 border-bottom-0" id="messageTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold text-dark border-0 border-bottom border-dark border-2" id="read-tab" data-bs-toggle="tab" data-bs-target="#read-pane" type="button" role="tab">READ MESSAGES</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold text-dark border-0" id="post-tab" data-bs-toggle="tab" data-bs-target="#post-pane" type="button" role="tab">POST A MESSAGE</button>
                    </li>
                </ul>
                <button type="button" class="btn-close align-self-start mt-2" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="tab-content" id="messageTabsContent">
                    <div class="tab-pane fade show active" id="read-pane" role="tabpanel" style="max-height:50vh; overflow-y: auto;">
                        @if (Model.Messages.Any())
                        {
                            foreach (var msg in Model.Messages)
                            {
                                <div class="message-card">
                                    <p class="mb-0 fs-5">"@msg.MessageContent"</p>
                                    <span class="message-sender">— @msg.SenderName</span>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted text-center py-4">No messages yet. Be the first!</p>
                        }
                    </div>
                    <div class="tab-pane fade" id="post-pane" role="tabpanel">
                        <form action="/Home/PostMessage" method="post" class="mt-3">
                            <div class="mb-4">
                                <label class="form-label fw-bold">YOUR NAME</label>
                                <input type="text" name="sender" class="form-control clean-input" required />
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-bold">YOUR MESSAGE</label>
                                <textarea name="content" class="form-control clean-input" rows="4" required></textarea>
                            </div>
                            <button type="submit" class="btn-black w-100">SEND MESSAGE</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="discographyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="section-title mb-0">Discography</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="max-height:70vh; overflow-y: auto;">

                <h4 class="mt-4 mb-3 fw-bold border-bottom pb-2">2024</h4>
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="card border-0">
                            <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/17isrighthere.jpg") : assetBase + "/images/albums/17isrighthere.jpg")" class="card-img-top grayscale-hover" alt="17 Is Right Here" onerror="this.src='https://placehold.co/300x300?text=17+Is+Right+Here'">
                            <div class="card-body px-0">
                                <h5 class="fw-bold mb-0">17 Is Right Here</h5>
                                <p class="text-muted small">Best Album</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0">
                            <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/spillthefeels.jpg") : assetBase + "/images/albums/spillthefeels.jpg")" class="card-img-top grayscale-hover" alt="Spill The Feels" onerror="this.src='https://placehold.co/300x300?text=Spill+The+Feels'">
                            <div class="card-body px-0">
                                <h5 class="fw-bold mb-0">Spill The Feels</h5>
                                <p class="text-muted small">12th Mini Album</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0">
                            <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/shohikigen.jpg") : assetBase + "/images/albums/shohikigen.jpg")" class="card-img-top grayscale-hover" alt="Shohikigen" onerror="this.src='https://placehold.co/300x300?text=Shohikigen'">
                            <div class="card-body px-0">
                                <h5 class="fw-bold mb-0">Shohikigen</h5>
                                <p class="text-muted small">JP Single</p>
                            </div>
                        </div>
                    </div>
                </div>

                <h4 class="mt-5 mb-3 fw-bold border-bottom pb-2">2023</h4>
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="card border-0">
                            <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/fml.jpg") : assetBase + "/images/albums/fml.jpg")" class="card-img-top grayscale-hover" alt="FML" onerror="this.src='https://placehold.co/300x300?text=FML'">
                            <div class="card-body px-0">
                                <h5 class="fw-bold mb-0">FML</h5>
                                <p class="text-muted small">10th Mini Album</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0">
                            <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/seventeenthheaven.jpg") : assetBase + "/images/albums/seventeenthheaven.jpg")" class="card-img-top grayscale-hover" alt="Seventeenth Heaven" onerror="this.src='https://placehold.co/300x300?text=Seventeenth+Heaven'">
                            <div class="card-body px-0">
                                <h5 class="fw-bold mb-0">Seventeenth Heaven</h5>
                                <p class="text-muted small">11th Mini Album</p>
                            </div>
                        </div>
                    </div>
                </div>

                <h4 class="mt-5 mb-3 fw-bold border-bottom pb-2">2015 (Debut)</h4>
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="card border-0">
                            <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/17carat.jpg") : assetBase + "/images/albums/17carat.jpg")" class="card-img-top grayscale-hover" alt="17 Carat" onerror="this.src='https://placehold.co/300x300?text=17+Carat'">
                            <div class="card-body px-0">
                                <h5 class="fw-bold mb-0">17 Carat</h5>
                                <p class="text-muted small">1st Mini Album</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:2000; margin-bottom:80px;">
    <div id="successToast" class="toast align-items-center text-white bg-black border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fw-bold">
                <i class="bi bi-check-circle-fill me-2 text-success"></i> Message successfully added to the archive!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@if (TempData["ShowMessages"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Trigger the success toast
            var toastElList = [].slice.call(document.querySelectorAll('.toast'))
            var toastList = toastElList.map(function (toastEl) {
              return new bootstrap.Toast(toastEl, { delay:4000 }); // disappears after4 seconds
            });
            toastList.forEach(toast => toast.show());
        });
    </script>
}