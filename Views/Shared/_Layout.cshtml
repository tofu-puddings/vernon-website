@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@functions {
    private string AssetBase() => Configuration["AssetBaseUrl"]?.TrimEnd('/') ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Vernon Arcade</title>

    <style>
        /* ──────────────── IMPORTS ──────────────── */
        @@import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&family=Inter:wght@400;600;700;900&display=swap');

        /* ──────────────── BASE / CRT ──────────────── */
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', sans-serif;
            background: #0a0a0f;
            color: #e0e0e0;
            min-height: 100vh;
            overflow-x: hidden;
        }
        /* Scanline overlay */
        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: repeating-linear-gradient(0deg, rgba(0,0,0,0.15) 0px, rgba(0,0,0,0.15) 2px, transparent 2px, transparent 6px);
            pointer-events: none;
            z-index: 9999;
        }

        /* ──────────────── FLIP PHONE INTRO ──────────────── */
        #introScreen {
            position: fixed;
            inset: 0;
            background: radial-gradient(circle at center, #1a0b2e, #0a0a0f);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10000;
            transition: opacity 0.8s ease, transform 0.8s ease;
        }
        #introScreen.hidden {
            opacity: 0;
            transform: scale(1.1);
            pointer-events: none;
        }

        .flip-phone {
            background: linear-gradient(145deg, #2a2a3a, #1a1a2a);
            border-radius: 40px 40px 20px 20px;
            padding: 20px 20px 30px;
            width: 320px;
            box-shadow: 0 0 60px rgba(0, 243, 255, 0.3), inset 0 -4px 8px rgba(0,0,0,0.8);
            border: 2px solid #3a3a4a;
            transform: rotate(-2deg);
            transition: transform 0.3s;
        }
        .flip-phone:hover { transform: rotate(0deg) scale(1.02); }

        .phone-hinge {
            width: 60px;
            height: 6px;
            background: #2a2a3a;
            margin: 0 auto 10px;
            border-radius: 10px;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.8);
        }
        .phone-screen {
            background: #0f0f1a;
            border-radius: 24px;
            padding: 24px 18px 18px;
            border: 2px solid #4a4a5a;
            box-shadow: inset 0 0 20px rgba(0, 243, 255, 0.1);
            min-height: 200px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            font-family: 'VT323', monospace;
        }
        .phone-screen .call-icon { font-size: 2.5rem; margin-bottom: 0.25rem; animation: pulse 1.5s infinite; }
        .phone-screen .caller-id {
            font-size: 1.8rem;
            color: #00f3ff;
            text-shadow: 0 0 20px #00f3ff;
            letter-spacing: 4px;
        }
        .phone-screen .question {
            font-size: 1.4rem;
            color: #ff00cc;
            margin-top: 0.5rem;
            text-shadow: 0 0 20px #ff00cc;
        }
        .phone-screen .sub-text { font-size: 0.9rem; color: #8888aa; margin-top: 0.5rem; }
        @@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

        .phone-keypad {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-top: 16px;
            padding: 0 8px;
        }
        .phone-key {
            background: #2a2a3a;
            border: none;
            color: #aaa;
            padding: 10px 0;
            border-radius: 30px;
            font-family: 'VT323', monospace;
            font-size: 1.2rem;
            box-shadow: inset 0 -3px 0 #0a0a0f, 0 2px 4px rgba(0,0,0,0.5);
            cursor: pointer;
            transition: 0.1s;
        }
        .phone-key:active { transform: scale(0.95); }
        .phone-key .letters { font-size: 0.5rem; color: #555; display: block; }
        .phone-key.call-btn {
            background: #00ff41;
            color: #0a0a0f;
            font-weight: bold;
            font-size: 1.4rem;
            box-shadow: 0 0 20px rgba(0, 255, 65, 0.4);
            grid-column: span 1;
        }
        .phone-key.call-btn:hover { background: #33ff66; }

        /* ──────────────── ARCADE LAYOUT ──────────────── */
        #mainApp {
            display: none;
            flex-direction: column;
            min-height: 100vh;
            background: #0a0a0f;
        }
        #mainApp.active { display: flex; }

        /* ── Top Bar (Music + Marquee) ── */
        .top-bar {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(10, 10, 15, 0.92);
            backdrop-filter: blur(8px);
            border-bottom: 2px solid #00f3ff;
            box-shadow: 0 4px 30px rgba(0, 243, 255, 0.15);
            padding: 6px 0;
        }
        .marquee-container {
            background: #1a0b2e;
            border-top: 1px solid #ff00cc;
            border-bottom: 1px solid #ff00cc;
            padding: 4px 0;
            overflow: hidden;
            white-space: nowrap;
        }
        .marquee-text {
            display: inline-block;
            font-family: 'VT323', monospace;
            font-size: 1.1rem;
            color: #ff00cc;
            text-shadow: 0 0 10px #ff00cc;
            animation: marqueeScroll 20s linear infinite;
            letter-spacing: 2px;
        }
        @@keyframes marqueeScroll {
            0% { transform: translateX(100%); }
            100% { transform: translateX(-100%); }
        }
        .music-player-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            padding: 6px 1.5rem;
            gap: 0.5rem;
        }
        .music-player-top .track-info { display: flex; align-items: baseline; gap: 0.75rem; font-size: 0.9rem; }
        .music-player-top .track-info .title { color: #fff; font-weight: 600; }
        .music-player-top .track-info .artist { color: #888; }
        .music-player-top .controls { display: flex; gap: 0.5rem; align-items: center; }
        .music-player-top .controls button {
            background: none; border: none; color: #00f3ff;
            font-size: 1.4rem; cursor: pointer; transition: 0.2s;
        }
        .music-player-top .controls button:hover { color: #ff00cc; text-shadow: 0 0 20px #ff00cc; }
        .music-player-top .controls .play-btn { font-size: 1.8rem; }
        .record-icon {
            display: inline-block;
            animation: spin 2s linear infinite;
            animation-play-state: paused;
        }
        @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* ── Arcade Grid ── */
        .arcade-grid {
            display: grid;
            grid-template-columns: 140px 1fr 280px;
            gap: 1.5rem;
            padding: 1.5rem;
            flex: 1;
            min-height: calc(100vh - 110px);
        }
        @@media (max-width: 900px) {
            .arcade-grid {
                grid-template-columns: 1fr;
                grid-template-rows: auto 1fr auto;
                padding: 1rem;
                gap: 1rem;
            }
        }

        /* ── Left: Joystick ── */
        .joystick-panel {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: rgba(20, 10, 40, 0.6);
            border-radius: 2rem;
            border: 2px solid #3a2a5a;
            box-shadow: inset 0 0 40px rgba(0, 243, 255, 0.05);
            padding: 1.5rem 0.5rem;
        }
        .joystick-base {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, #2a2a3a, #0a0a0f);
            border: 4px solid #00f3ff;
            box-shadow: 0 0 30px rgba(0, 243, 255, 0.2), inset 0 0 20px rgba(0,0,0,0.8);
            position: relative;
            margin-bottom: 1.5rem;
        }
        .joystick-stick {
            width: 44px;
            height: 44px;
            background: radial-gradient(circle at 40% 40%, #ff00cc, #990066);
            border-radius: 50%;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            box-shadow: 0 0 30px rgba(255, 0, 204, 0.4);
            border: 2px solid #ff66dd;
            cursor: grab;
            transition: 0.1s;
        }
        .joystick-stick:active { cursor: grabbing; }

        .dpad {
            display: grid;
            grid-template-columns: 40px 40px 40px;
            grid-template-rows: 40px 40px 40px;
            gap: 4px;
            margin-bottom: 1rem;
        }
        .dpad-btn {
            background: #1a1a2a;
            border: 1px solid #3a3a5a;
            border-radius: 6px;
            color: #00f3ff;
            font-size: 1.2rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.1s;
            box-shadow: inset 0 -2px 0 #0a0a0f;
        }
        .dpad-btn:hover { background: #2a2a4a; border-color: #00f3ff; }
        .dpad-btn:active { transform: scale(0.92); }
        .dpad-up { grid-column: 2; grid-row: 1; }
        .dpad-left { grid-column: 1; grid-row: 2; }
        .dpad-center { grid-column: 2; grid-row: 2; background: #ff00cc; border-color: #ff00cc; color: #fff; font-weight: bold; font-size: 0.7rem; }
        .dpad-right { grid-column: 3; grid-row: 2; }
        .dpad-down { grid-column: 2; grid-row: 3; }

        .select-btn {
            background: #ff00cc;
            border: none;
            color: #fff;
            font-family: 'VT323', monospace;
            font-size: 1.2rem;
            padding: 0.5rem 2rem;
            border-radius: 40px;
            box-shadow: 0 0 30px rgba(255, 0, 204, 0.3);
            cursor: pointer;
            transition: 0.2s;
            margin-top: 0.5rem;
        }
        .select-btn:hover { box-shadow: 0 0 50px rgba(255, 0, 204, 0.6); transform: scale(1.05); }

        /* ── Center: Dynamic Content ── */
        .center-panel {
            background: rgba(10, 10, 20, 0.7);
            border-radius: 2rem;
            border: 2px solid #00f3ff;
            box-shadow: inset 0 0 60px rgba(0, 243, 255, 0.05), 0 0 40px rgba(0, 243, 255, 0.1);
            padding: 1.5rem;
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(4px);
        }
        .center-panel .bg-art {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            opacity: 0.15;
            filter: blur(8px) grayscale(0.5);
            transition: background-image 0.6s ease;
            z-index: 0;
        }
        .center-panel .tab-content {
            position: relative;
            z-index: 1;
            max-height: 70vh;
            overflow-y: auto;
            padding-right: 0.5rem;
        }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .tab-content::-webkit-scrollbar { width: 6px; }
        .tab-content::-webkit-scrollbar-track { background: transparent; }
        .tab-content::-webkit-scrollbar-thumb { background: #00f3ff; border-radius: 10px; }

        /* ── Right: Fan Messages ── */
        .right-panel {
            background: rgba(20, 10, 40, 0.6);
            border-radius: 2rem;
            border: 2px solid #ff00cc;
            box-shadow: inset 0 0 40px rgba(255, 0, 204, 0.05);
            padding: 1.5rem 1rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            overflow: hidden;
        }
        .right-panel .thumb {
            width: 100%;
            aspect-ratio: 1/1;
            border-radius: 1.5rem;
            object-fit: cover;
            border: 2px solid #ff00cc;
            box-shadow: 0 0 30px rgba(255, 0, 204, 0.15);
            transition: 0.3s;
        }
        .right-panel .msg-title {
            font-family: 'VT323', monospace;
            color: #ff00cc;
            font-size: 1.2rem;
            text-align: center;
            text-shadow: 0 0 20px #ff00cc;
            border-bottom: 1px solid #3a2a5a;
            padding-bottom: 0.5rem;
        }
        .right-panel .msg-list {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            max-height: 300px;
        }
        .msg-item {
            background: rgba(0, 0, 0, 0.4);
            padding: 0.75rem;
            border-radius: 0.75rem;
            border-left: 3px solid #00f3ff;
            font-size: 0.85rem;
        }
        .msg-item .sender { color: #00f3ff; font-weight: 600; }
        .msg-item .text { color: #ccc; }
        .right-panel .msg-form input,
        .right-panel .msg-form textarea {
            width: 100%;
            background: #0a0a0f;
            border: 1px solid #3a2a5a;
            border-radius: 0.75rem;
            padding: 0.5rem 0.75rem;
            color: #fff;
            font-family: 'Inter', sans-serif;
            margin-bottom: 0.5rem;
            outline: none;
            font-size: 0.8rem;
        }
        .right-panel .msg-form input:focus,
        .right-panel .msg-form textarea:focus { border-color: #00f3ff; }
        .right-panel .msg-form button {
            width: 100%;
            background: #00f3ff;
            color: #0a0a0f;
            border: none;
            padding: 0.5rem;
            border-radius: 40px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.2s;
        }
        .right-panel .msg-form button:hover { box-shadow: 0 0 30px rgba(0, 243, 255, 0.3); }

        /* ──────────────── TAB CONTENT STYLES ──────────────── */
        .profile-grid { display: flex; flex-direction: column; gap: 1rem; }
        .profile-grid .name {
            font-family: 'Press Start 2P', monospace;
            color: #00f3ff;
            text-shadow: 0 0 30px #00f3ff;
            font-size: 1.4rem;
        }
        .fact-list { list-style: none; padding: 0; }
        .fact-list li {
            padding: 0.4rem 0;
            border-bottom: 1px solid #1a1a2a;
            display: flex;
            gap: 0.5rem;
            color: #ccc;
        }
        .fact-list li::before { content: "✦"; color: #ff00cc; }

        .disco-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 1rem;
        }
        .disco-card {
            background: rgba(0,0,0,0.3);
            border-radius: 1rem;
            padding: 0.75rem;
            text-align: center;
            border: 1px solid #2a2a4a;
        }
        .disco-card img { width: 100%; border-radius: 0.5rem; margin-bottom: 0.5rem; }
        .disco-card .year { color: #888; font-size: 0.7rem; }

        .album-timeline { display: flex; flex-direction: column; gap: 1.5rem; }
        .album-era {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            align-items: center;
        }
        .album-era .era-label {
            font-family: 'Press Start 2P', monospace;
            color: #ff00cc;
            min-width: 80px;
            font-size: 0.8rem;
        }
        .album-era .pics { display: flex; flex-wrap: wrap; gap: 0.5rem; }
        .album-era .pics img {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 0.75rem;
            border: 2px solid #3a2a5a;
            transition: 0.2s;
        }
        .album-era .pics img:hover { border-color: #00f3ff; transform: scale(1.05); }

        .random-box {
            background: rgba(0, 0, 0, 0.4);
            border-radius: 1.5rem;
            padding: 2rem;
            text-align: center;
            border: 2px dashed #ff00cc;
        }
        .random-box .quote {
            font-size: 1.4rem;
            color: #fff;
            font-family: 'VT323', monospace;
            margin: 1rem 0;
        }
        .random-box .btn-spin {
            background: #ff00cc;
            border: none;
            color: #fff;
            padding: 0.75rem 2rem;
            border-radius: 40px;
            font-weight: bold;
            cursor: pointer;
            font-size: 1.2rem;
            box-shadow: 0 0 30px rgba(255, 0, 204, 0.3);
        }
        .random-box .btn-spin:hover { box-shadow: 0 0 60px rgba(255, 0, 204, 0.6); }

        /* ──────────────── TOAST / BACK TO TOP ──────────────── */
        .toast-container {
            position: fixed; bottom: 2rem; right: 2rem; z-index: 9000;
        }
        .toast {
            background: #1a0b2e; border: 1px solid #00f3ff;
            color: #fff; padding: 0.75rem 1.5rem; border-radius: 0.75rem;
            display: none; align-items: center; gap: 0.75rem;
            box-shadow: 0 0 40px rgba(0, 243, 255, 0.2);
        }
        .toast.show { display: flex; }

        #backToTop {
            position: fixed; bottom: 6rem; right: 2rem; z-index: 999;
            background: #ff00cc; color: #fff; border: none;
            width: 48px; height: 48px; border-radius: 9999px;
            font-size: 1.5rem; cursor: pointer;
            box-shadow: 0 0 30px rgba(255, 0, 204, 0.3);
            opacity: 0; transition: 0.3s;
        }
        #backToTop.visible { opacity: 1; }
    </style>
</head>
<body>

    <!-- ===== INTRO SCREEN (FLIP PHONE) ===== -->
    <div id="introScreen">
        <div class="flip-phone">
            <div class="phone-hinge"></div>
            <div class="phone-screen">
                <div class="call-icon">📞</div>
                <div class="caller-id">VERNON</div>
                <div class="question">"WILL YOU PLAY<br>WITH VERNON?"</div>
                <div class="sub-text">✦ PRESS CALL ✦</div>
            </div>
            <div class="phone-keypad">
                <button class="phone-key">1</button>
                <button class="phone-key">2</button>
                <button class="phone-key">3</button>
                <button class="phone-key">4</button>
                <button class="phone-key">5</button>
                <button class="phone-key">6</button>
                <button class="phone-key">7</button>
                <button class="phone-key">8</button>
                <button class="phone-key">9</button>
                <button class="phone-key">*</button>
                <button class="phone-key call-btn" id="callBtn">CALL</button>
                <button class="phone-key">#</button>
            </div>
        </div>
    </div>

    <!-- ===== MAIN ARCADE APP ===== -->
    <div id="mainApp">
        <!-- TOP BAR -->
        <div class="top-bar">
            <div class="marquee-container">
                <span class="marquee-text">
                    ✦ WELCOME TO THE VERNON ARCADE ✦ HANSOL ✦ SEVENTEEN ✦ HIP-HOP ✦ 1998 ✦ NEW YORK ✦ 
                    ✦ PLAY THE ALBUMS ✦ COLLECT THE MOMENTS ✦ PRESS SELECT ✦ 
                </span>
            </div>
            <div class="music-player-top">
                <div class="track-info">
                    <span class="record-icon" id="recordIcon">💿</span>
                    <span class="title" id="trackTitle">Black Eye</span>
                    <span class="artist" id="trackArtist">/ Vernon</span>
                </div>
                <div class="controls">
                    <button onclick="prevTrack()">⏮</button>
                    <button onclick="togglePlay()" id="playBtn" class="play-btn">▶</button>
                    <button onclick="nextTrack()">⏭</button>
                </div>
                <audio id="audioPlayer"></audio>
            </div>
        </div>

        <!-- ARCADE GRID -->
        <div class="arcade-grid">
            <!-- LEFT: JOYSTICK -->
            <div class="joystick-panel">
                <div class="joystick-base">
                    <div class="joystick-stick" id="joystickStick"></div>
                </div>
                <div class="dpad">
                    <button class="dpad-btn dpad-up" id="upBtn">▲</button>
                    <button class="dpad-btn dpad-left" id="leftBtn">◀</button>
                    <button class="dpad-btn dpad-center" id="selectBtn">SEL</button>
                    <button class="dpad-btn dpad-right" id="rightBtn">▶</button>
                    <button class="dpad-btn dpad-down" id="downBtn">▼</button>
                </div>
                <button class="select-btn" id="bigSelectBtn">⚡ SELECT ⚡</button>
            </div>

            <!-- CENTER: DYNAMIC CONTENT -->
            <div class="center-panel" id="centerPanel">
                <div class="bg-art" id="bgArt"></div>
                <div class="tab-content" id="tabContainer">
                    @RenderBody()
                </div>
            </div>

            <!-- RIGHT: FAN MESSAGES -->
            <div class="right-panel" id="rightPanel">
                <img id="rightThumb" class="thumb" src="@(string.IsNullOrEmpty(AssetBase()) ? Url.Content("~/images/vernon/kpoppapi.jpg") : AssetBase() + "/images/vernon/kpoppapi.jpg")" alt="Vernon" />
                <div class="msg-title">✧ FAN MESSAGES ✧</div>
                <div class="msg-list" id="msgList">
                    <!-- Populated dynamically -->
                </div>
                <form class="msg-form" id="msgForm" action="/Home/PostMessage" method="post">
                    @Html.AntiForgeryToken()
                    <input type="text" name="sender" placeholder="Your name..." maxlength="20" required />
                    <textarea name="content" placeholder="Your message..." rows="2" maxlength="200" required></textarea>
                    <button type="submit">SEND MESSAGE</button>
                </form>
            </div>
        </div>
    </div>

    <!-- ===== TOAST ===== -->
    <div class="toast-container" id="toastContainer">
        <div class="toast" id="successToast">
            <span>✅</span>
            <span id="toastMessage">Done!</span>
        </div>
    </div>

    <!-- ===== BACK TO TOP ===== -->
    <button id="backToTop">↑</button>

    <!-- ========================================================== -->
    <!-- ===== SCRIPTS ===== -->
    <script>
        // ── INTRO TO ARCADE TRANSITION ──
        document.getElementById('callBtn').addEventListener('click', function() {
            document.getElementById('introScreen').classList.add('hidden');
            document.getElementById('mainApp').classList.add('active');
        });

        // ── MUSIC PLAYER ──
        const playlist = [
            { title: "Black Eye", artist: "/ Vernon", src: '@(string.IsNullOrEmpty(AssetBase()) ? Url.Content("~/audio/blackeye.mp3") : AssetBase() + "/audio/blackeye.mp3")' },
            { title: "Shining Star", artist: "/ Vernon", src: '@(string.IsNullOrEmpty(AssetBase()) ? Url.Content("~/audio/shiningstar.mp3") : AssetBase() + "/audio/shiningstar.mp3")' }
        ];
        let currentTrackIndex = 0;
        const audio = document.getElementById('audioPlayer');
        const playBtn = document.getElementById('playBtn');
        const trackTitle = document.getElementById('trackTitle');
        const trackArtist = document.getElementById('trackArtist');
        const recordIcon = document.getElementById('recordIcon');

        function loadTrack(index) {
            const track = playlist[index];
            audio.src = track.src;
            trackTitle.textContent = track.title;
            trackArtist.textContent = track.artist;
        }
        function togglePlay() {
            if (audio.paused) {
                audio.play();
                playBtn.textContent = '⏸';
                recordIcon.style.animationPlayState = 'running';
            } else {
                audio.pause();
                playBtn.textContent = '▶';
                recordIcon.style.animationPlayState = 'paused';
            }
        }
        function nextTrack() {
            currentTrackIndex = (currentTrackIndex + 1) % playlist.length;
            loadTrack(currentTrackIndex);
            audio.play();
            playBtn.textContent = '⏸';
            recordIcon.style.animationPlayState = 'running';
        }
        function prevTrack() {
            currentTrackIndex = (currentTrackIndex - 1 + playlist.length) % playlist.length;
            loadTrack(currentTrackIndex);
            audio.play();
            playBtn.textContent = '⏸';
            recordIcon.style.animationPlayState = 'running';
        }
        loadTrack(0);

        // ── TOAST ──
        function showToast(message) {
            const toast = document.getElementById('successToast');
            document.getElementById('toastMessage').textContent = message;
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 4000);
        }

        // ── BACK TO TOP ──
        const backToTopBtn = document.getElementById('backToTop');
        window.addEventListener('scroll', function() {
            backToTopBtn.classList.toggle('visible', window.scrollY > 300);
        });
        backToTopBtn.addEventListener('click', function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
