@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@functions {
    private string AssetBase() => Configuration["AssetBaseUrl"]?.TrimEnd('/') ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Vernon Arcade</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <!-- ===== INTRO SCREEN (FLIP PHONE) ===== -->
    <div id="introScreen">
        <div class="flip-phone">
            <div class="phone-hinge"></div>
            <div class="phone-screen">
                <div class="call-icon">📞</div>
                <div class="caller-id">VERNON</div>
                <div class="question">"WILL YOU PLAY<br>WITH VERNON?"</div>
                <div class="sub-text">✦ PRESS CALL ✦</div>
            </div>
            <div class="phone-keypad">
                <button class="phone-key">1</button>
                <button class="phone-key">2</button>
                <button class="phone-key">3</button>
                <button class="phone-key">4</button>
                <button class="phone-key">5</button>
                <button class="phone-key">6</button>
                <button class="phone-key">7</button>
                <button class="phone-key">8</button>
                <button class="phone-key">9</button>
                <button class="phone-key">*</button>
                <button class="phone-key call-btn" id="callBtn">CALL</button>
                <button class="phone-key">#</button>
            </div>
        </div>
    </div>

    <!-- ===== MAIN ARCADE APP ===== -->
    <div id="mainApp">
        <!-- TOP BAR -->
        <div class="top-bar">
            <div class="marquee-container">
                <span class="marquee-text">
                    ✦ WELCOME TO THE VERNON ARCADE ✦ HANSOL ✦ SEVENTEEN ✦ HIP-HOP ✦ 1998 ✦ NEW YORK ✦ 
                    ✦ PLAY THE ALBUMS ✦ COLLECT THE MOMENTS ✦ PRESS SELECT ✦ 
                </span>
            </div>
            <div class="music-player-top">
                <div class="track-info">
                    <span class="record-icon" id="recordIcon">💿</span>
                    <span class="title" id="trackTitle">Black Eye</span>
                    <span class="artist" id="trackArtist">/ Vernon</span>
                </div>
                <div class="controls">
                    <button onclick="prevTrack()">⏮</button>
                    <button onclick="togglePlay()" id="playBtn" class="play-btn">▶</button>
                    <button onclick="nextTrack()">⏭</button>
                </div>
                <audio id="audioPlayer"></audio>
            </div>
        </div>

        <!-- ARCADE GRID -->
        <div class="arcade-grid">
            <!-- LEFT: JOYSTICK -->
            <div class="joystick-panel">
                <div class="joystick-base">
                    <div class="joystick-stick" id="joystickStick"></div>
                </div>
                <div class="dpad">
                    <button class="dpad-btn dpad-up" id="upBtn">▲</button>
                    <button class="dpad-btn dpad-left" id="leftBtn">◀</button>
                    <button class="dpad-btn dpad-center" id="selectBtn">SEL</button>
                    <button class="dpad-btn dpad-right" id="rightBtn">▶</button>
                    <button class="dpad-btn dpad-down" id="downBtn">▼</button>
                </div>
                <button class="select-btn" id="bigSelectBtn">⚡ SELECT ⚡</button>
            </div>

            <!-- CENTER: DYNAMIC CONTENT -->
            <div class="center-panel" id="centerPanel">
                <div class="bg-art" id="bgArt"></div>
                <div class="tab-content" id="tabContainer">
                    <!-- Content is rendered by Index.cshtml -->
                    @RenderBody()
                </div>
            </div>

            <!-- RIGHT: FAN MESSAGES -->
            <div class="right-panel" id="rightPanel">
                <img id="rightThumb" class="thumb" src="@(string.IsNullOrEmpty(AssetBase()) ? Url.Content("~/images/vernon/kpoppapi.jpg") : AssetBase() + "/images/vernon/kpoppapi.jpg")" alt="Vernon" />
                <div class="msg-title">✧ FAN MESSAGES ✧</div>
                <div class="msg-list" id="msgList">
                    <!-- Dynamically populated from server model, but also via JS -->
                </div>
                <form class="msg-form" id="msgForm" action="/Home/PostMessage" method="post">
                    @Html.AntiForgeryToken()
                    <input type="text" name="sender" placeholder="Your name..." maxlength="20" required />
                    <textarea name="content" placeholder="Your message..." rows="2" maxlength="200" required></textarea>
                    <button type="submit">SEND MESSAGE</button>
                </form>
            </div>
        </div>
    </div>

    <!-- ===== TOAST ===== -->
    <div class="toast-container" id="toastContainer">
        <div class="toast" id="successToast">
            <span>✅</span>
            <span id="toastMessage">Done!</span>
        </div>
    </div>

    <!-- ===== BACK TO TOP ===== -->
    <button id="backToTop">↑</button>

    <!-- ========================================================== -->
    <!-- ===== SCRIPTS ===== -->
    <script>
        // ── INTRO TO ARCADE TRANSITION ──
        document.getElementById('callBtn').addEventListener('click', function() {
            document.getElementById('introScreen').classList.add('hidden');
            document.getElementById('mainApp').classList.add('active');
            // Start music or any initial effect
        });

        // ── MUSIC PLAYER ──
        const playlist = [
            { title: "Black Eye", artist: "/ Vernon", src: '@(string.IsNullOrEmpty(AssetBase()) ? Url.Content("~/audio/blackeye.mp3") : AssetBase() + "/audio/blackeye.mp3")' },
            { title: "Shining Star", artist: "/ Vernon", src: '@(string.IsNullOrEmpty(AssetBase()) ? Url.Content("~/audio/shiningstar.mp3") : AssetBase() + "/audio/shiningstar.mp3")' }
        ];
        let currentTrackIndex = 0;
        const audio = document.getElementById('audioPlayer');
        const playBtn = document.getElementById('playBtn');
        const trackTitle = document.getElementById('trackTitle');
        const trackArtist = document.getElementById('trackArtist');
        const recordIcon = document.getElementById('recordIcon');

        function loadTrack(index) {
            const track = playlist[index];
            audio.src = track.src;
            trackTitle.textContent = track.title;
            trackArtist.textContent = track.artist;
        }
        function togglePlay() {
            if (audio.paused) {
                audio.play();
                playBtn.textContent = '⏸';
                recordIcon.style.animationPlayState = 'running';
            } else {
                audio.pause();
                playBtn.textContent = '▶';
                recordIcon.style.animationPlayState = 'paused';
            }
        }
        function nextTrack() {
            currentTrackIndex = (currentTrackIndex + 1) % playlist.length;
            loadTrack(currentTrackIndex);
            audio.play();
            playBtn.textContent = '⏸';
            recordIcon.style.animationPlayState = 'running';
        }
        function prevTrack() {
            currentTrackIndex = (currentTrackIndex - 1 + playlist.length) % playlist.length;
            loadTrack(currentTrackIndex);
            audio.play();
            playBtn.textContent = '⏸';
            recordIcon.style.animationPlayState = 'running';
        }
        loadTrack(0);

        // ── TOAST ──
        function showToast(message) {
            const toast = document.getElementById('successToast');
            document.getElementById('toastMessage').textContent = message;
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 4000);
        }

        // ── BACK TO TOP ──
        const backToTopBtn = document.getElementById('backToTop');
        window.addEventListener('scroll', function() {
            backToTopBtn.classList.toggle('visible', window.scrollY > 300);
        });
        backToTopBtn.addEventListener('click', function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // ── TAB SWITCHING LOGIC (joystick + center panel) ──
        // Defined in Index.cshtml to allow Razor model binding for content.
        // The script tag below is placed after the @RenderBody() in Index.
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
