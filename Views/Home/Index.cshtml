@model VernonFanSite.Models.HomeViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Arcade";
    var assetBase = Configuration["AssetBaseUrl"]?.TrimEnd('/') ?? "";
}

<!-- TAB 1: PROFILE -->
<div class="tab-content active" data-tab="0" data-image="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/vernon/kpoppapi.jpg") : assetBase + "/images/vernon/kpoppapi.jpg")">
    <div class="profile-grid">
        <div>
            <div class="name">✦ PROFILE ✦</div>
            <p style="color: #888; font-size: 0.9rem;">SEVENTEEN / Hip-Hop Team</p>
        </div>
        <ul class="fact-list">
            @foreach (var fact in Model.FunFacts)
            {
                <li>@fact</li>
            }
        </ul>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.5rem;">
            <span style="background: #1a0b2e; padding: 0.25rem 0.75rem; border-radius: 20px; border: 1px solid #00f3ff;">🇺🇸 NYC</span>
            <span style="background: #1a0b2e; padding: 0.25rem 0.75rem; border-radius: 20px; border: 1px solid #ff00cc;">🎤 Rapper</span>
            <span style="background: #1a0b2e; padding: 0.25rem 0.75rem; border-radius: 20px; border: 1px solid #00f3ff;">🐱 Cat Dad</span>
        </div>
    </div>
</div>

<!-- TAB 2: DISCOGRAPHY -->
<div class="tab-content" data-tab="1" data-image="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/fml.jpg") : assetBase + "/images/albums/fml.jpg")">
    <h3 style="font-family: 'VT323', monospace; color: #00f3ff; margin-bottom: 1rem;">🎵 DISCOGRAPHY</h3>
    <div class="disco-grid">
        <div class="disco-card">
            <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/17isrighthere.jpg") : assetBase + "/images/albums/17isrighthere.jpg")" onerror="this.src='https://placehold.co/120x120?text=2024'"/>
            <div><strong>17 Is Right Here</strong></div>
            <div class="year">2024 · Best</div>
        </div>
        <div class="disco-card">
            <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/spillthefeels.jpg") : assetBase + "/images/albums/spillthefeels.jpg")" onerror="this.src='https://placehold.co/120x120?text=2024'"/>
            <div><strong>Spill The Feels</strong></div>
            <div class="year">2024 · Mini 12</div>
        </div>
        <div class="disco-card">
            <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/shohikigen.jpg") : assetBase + "/images/albums/shohikigen.jpg")" onerror="this.src='https://placehold.co/120x120?text=2024'"/>
            <div><strong>Shohikigen</strong></div>
            <div class="year">2024 · JP Single</div>
        </div>
        <div class="disco-card">
            <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/fml.jpg") : assetBase + "/images/albums/fml.jpg")" onerror="this.src='https://placehold.co/120x120?text=2023'"/>
            <div><strong>FML</strong></div>
            <div class="year">2023 · Mini 10</div>
        </div>
        <div class="disco-card">
            <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/seventeenthheaven.jpg") : assetBase + "/images/albums/seventeenthheaven.jpg")" onerror="this.src='https://placehold.co/120x120?text=2023'"/>
            <div><strong>Seventeenth Heaven</strong></div>
            <div class="year">2023 · Mini 11</div>
        </div>
        <div class="disco-card">
            <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/17carat.jpg") : assetBase + "/images/albums/17carat.jpg")" onerror="this.src='https://placehold.co/120x120?text=2015'"/>
            <div><strong>17 Carat</strong></div>
            <div class="year">2015 · Debut</div>
        </div>
    </div>
</div>

<!-- TAB 3: ALBUMS (Timeline) -->
<div class="tab-content" data-tab="2" data-image="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/17isrighthere.jpg") : assetBase + "/images/albums/17isrighthere.jpg")">
    <h3 style="font-family: 'VT323', monospace; color: #ff00cc; margin-bottom: 1rem;">📸 ALBUM TIMELINE</h3>
    <div class="album-timeline">
        <div class="album-era">
            <span class="era-label">2024</span>
            <div class="pics">
                <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/vernon/vernon1.jpg") : assetBase + "/images/vernon/vernon1.jpg")" />
                <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/vernon/vernon2.jpg") : assetBase + "/images/vernon/vernon2.jpg")" />
                <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/vernon/vernon3.jpg") : assetBase + "/images/vernon/vernon3.jpg")" />
            </div>
        </div>
        <div class="album-era">
            <span class="era-label">2023</span>
            <div class="pics">
                <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/vernon/vernon4.jpg") : assetBase + "/images/vernon/vernon4.jpg")" />
                <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/vernon/vernon5.jpg") : assetBase + "/images/vernon/vernon5.jpg")" />
                <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/vernon/vernon6.jpg") : assetBase + "/images/vernon/vernon6.jpg")" />
            </div>
        </div>
        <div class="album-era">
            <span class="era-label">2022</span>
            <div class="pics">
                <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/vernon/vernon7.jpg") : assetBase + "/images/vernon/vernon7.jpg")" />
                <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/vernon/vernon8.jpg") : assetBase + "/images/vernon/vernon8.jpg")" />
            </div>
        </div>
        <div class="album-era">
            <span class="era-label">2015</span>
            <div class="pics">
                <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/vernon/vernon9.jpg") : assetBase + "/images/vernon/vernon9.jpg")" />
                <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/vernon/vernon10.jpg") : assetBase + "/images/vernon/vernon10.jpg")" />
            </div>
        </div>
    </div>
</div>

<!-- TAB 4: RANDOM PLAY (Bonus) -->
<div class="tab-content" data-tab="3" data-image="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/vernon/vernon11.jpg") : assetBase + "/images/vernon/vernon11.jpg")">
    <h3 style="font-family: 'VT323', monospace; color: #00f3ff; margin-bottom: 1rem;">🎰 RANDOM VERNON</h3>
    <div class="random-box">
        <p style="color: #888;">PRESS SELECT TO GET A RANDOM FACT</p>
        <div class="quote" id="randomQuote">"Time is gold."</div>
        <button class="btn-spin" id="spinBtn">⟳ SPIN</button>
    </div>
</div>

<!-- ========================================================== -->
<!-- ===== SCRIPTS ===== -->
@section Scripts {
<script>
    // ── TAB DATA ──
    const tabs = document.querySelectorAll('.tab-content');
    const bgArt = document.getElementById('bgArt');
    const rightThumb = document.getElementById('rightThumb');
    let currentTab = 0;
    const totalTabs = tabs.length;

    // ── POPULATE FAN MESSAGES (from server model) ──
    const msgList = document.getElementById('msgList');
    @if (Model.Messages.Any())
    {
        foreach (var msg in Model.Messages)
        {
            <text>
                const div = document.createElement('div');
                div.className = 'msg-item';
                div.innerHTML = `<div class="sender">${'@msg.SenderName'}</div><div class="text">"${'@msg.MessageContent'}"</div>`;
                msgList.appendChild(div);
            </text>
        }
    }
    else
    {
        <text>msgList.innerHTML = '<div style="color: #888; text-align: center; padding: 1rem;">No messages yet. Be the first!</div>';</text>
    }

    // ── SWITCH TAB FUNCTION ──
    function switchTab(index) {
        if (index < 0) index = totalTabs - 1;
        if (index >= totalTabs) index = 0;
        currentTab = index;

        tabs.forEach((tab, i) => {
            tab.classList.toggle('active', i === index);
        });

        const active = tabs[index];
        const img = active.dataset.image;
        if (img) {
            bgArt.style.backgroundImage = `url(${img})`;
            rightThumb.src = img;
        }

        // Scroll to top of content smoothly
        document.getElementById('centerPanel').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // ── INIT ──
    switchTab(0);

    // ── JOYSTICK / DPAD CONTROLS ──
    document.getElementById('leftBtn').addEventListener('click', () => switchTab(currentTab - 1));
    document.getElementById('rightBtn').addEventListener('click', () => switchTab(currentTab + 1));
    document.getElementById('selectBtn').addEventListener('click', () => {
        // Random select: jump to random tab
        const rand = Math.floor(Math.random() * totalTabs);
        switchTab(rand);
        showToast('🎲 SELECTED: ' + tabs[rand].querySelector('h3')?.innerText || 'Tab ' + (rand+1));
    });
    document.getElementById('bigSelectBtn').addEventListener('click', () => {
        const rand = Math.floor(Math.random() * totalTabs);
        switchTab(rand);
        showToast('🎮 ARCADE SELECT: ' + tabs[rand].querySelector('h3')?.innerText || 'Tab ' + (rand+1));
    });

    // ── KEYBOARD SHORTCUTS (for fun) ──
    document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') switchTab(currentTab - 1);
        if (e.key === 'ArrowRight') switchTab(currentTab + 1);
        if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            document.getElementById('selectBtn').click();
        }
    });

    // ── RANDOM QUOTE SPINNER ──
    const quotes = [
        "I want to be a person who gives good influence.",
        "Life is like a camera – focus on what's important.",
        "Let's just be happy.",
        "Dreams do come true.",
        "I love our CARATs.",
        "Music is my language.",
        "Stay true to yourself.",
        "Every moment is a memory."
    ];
    document.getElementById('spinBtn').addEventListener('click', function() {
        const randomIndex = Math.floor(Math.random() * quotes.length);
        document.getElementById('randomQuote').textContent = '"' + quotes[randomIndex] + '"';
        this.textContent = '⟳ AGAIN!';
        showToast('✨ VERNON SAYS: ' + quotes[randomIndex]);
    });

    // ── CLIENT-SIDE PROFANITY FILTER ──
    document.getElementById('msgForm').addEventListener('submit', function(e) {
        const content = this.querySelector('textarea[name="content"]').value.toLowerCase();
        const badWords = ['fuck', 'shit', 'ass', 'bitch', 'cunt', 'whore', 'slut', 'bastard', 'idiot', 'stupid', 'hate', 'kill', 'die', 'racist', 'nazi', 'hitler', 'suicide', 'selfharm'];
        if (badWords.some(w => content.includes(w))) {
            e.preventDefault();
            showToast('Please remove inappropriate language.');
        }
    });

    // ── TOAST FOR SERVER MESSAGES ──
    @if (TempData["ShowMessages"] != null) {
        <text>showToast('Message posted! ✦');</text>
    }
    @if (TempData["Error"] != null) {
        <text>showToast('@TempData["Error"]');</text>
    }
</script>
}
