@model VernonFanSite.Models.HomeViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Home";
    var assetBase = Configuration["AssetBaseUrl"]?.TrimEnd('/') ?? "";
}

<!-- ===== HERO ===== -->
<div class="flex flex-col lg:flex-row items-center gap-16 py-8 lg:py-20">
    <div class="flex-1 text-center lg:text-left">
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black leading-[1.05] tracking-tight text-slate-900 dark:text-white">
            HANSOL<br>VERNON<br>CHWE.
        </h1>
        <p class="text-lg sm:text-xl text-slate-700 dark:text-slate-300 mt-4 max-w-md mx-auto lg:mx-0">
            Artist. Rapper. Visual. — The complete archive.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 mt-8 justify-center lg:justify-start">
            <button class="btn-primary" data-modal-toggle="factsModal">Profile & Facts</button>
            <button class="btn-primary" data-modal-toggle="discographyModal">Discography</button>
            <button class="btn-primary" data-modal-toggle="messagesModal">Fan Messages</button>
        </div>
    </div>
    <div class="flex-1 flex justify-center lg:justify-end">
        <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/vernon/kpoppapi.jpg") : assetBase + "/images/vernon/kpoppapi.jpg")"
             alt="Vernon"
             class="w-full max-w-md lg:max-w-lg rounded-3xl shadow-xl" />
    </div>
</div>

<!-- ===== COUNTDOWN ===== -->
<section class="py-12 border-t border-slate-200 dark:border-slate-800 mt-8">
    <div class="text-center max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white mb-2">⏳ Next Birthday</h2>
        <p class="text-slate-500 dark:text-slate-400 mb-6">Counting down to February 18, 2027</p>
        <div id="countdown" class="flex flex-wrap justify-center gap-4 sm:gap-6">
            <div class="text-center">
                <div class="countdown-number" id="days">00</div>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">Days</p>
            </div>
            <div class="text-center">
                <div class="countdown-number" id="hours">00</div>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">Hours</p>
            </div>
            <div class="text-center">
                <div class="countdown-number" id="minutes">00</div>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">Minutes</p>
            </div>
            <div class="text-center">
                <div class="countdown-number" id="seconds">00</div>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">Seconds</p>
            </div>
        </div>
    </div>
</section>

<!-- ===== YOUTUBE ===== -->
<section class="py-12 border-t border-slate-200 dark:border-slate-800">
    <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white text-center mb-2">🎬 Best Moments</h2>
        <p class="text-slate-500 dark:text-slate-400 text-center mb-8">Iconic performances</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="aspect-video rounded-xl overflow-hidden shadow-lg">
                <iframe class="w-full h-full" src="https://www.youtube.com/embed/Yg2gp7RMTdQ" title="Super" allowfullscreen loading="lazy"></iframe>
            </div>
            <div class="aspect-video rounded-xl overflow-hidden shadow-lg">
                <iframe class="w-full h-full" src="https://www.youtube.com/embed/Pu1aQvm5MrU" title="Left & Right" allowfullscreen loading="lazy"></iframe>
            </div>
            <div class="aspect-video rounded-xl overflow-hidden shadow-lg">
                <iframe class="w-full h-full" src="https://www.youtube.com/embed/gRnuFC4Ualw" title="Hot" allowfullscreen loading="lazy"></iframe>
            </div>
            <div class="aspect-video rounded-xl overflow-hidden shadow-lg">
                <iframe class="w-full h-full" src="https://www.youtube.com/embed/lXGcT8M5KbI" title="I Can't Run Away" allowfullscreen loading="lazy"></iframe>
            </div>
        </div>
    </div>
</section>

<!-- ========================================================== -->
<!-- ===== MODALS ===== -->
<!-- ========================================================== -->

<!-- Facts Modal -->
<div id="factsModal" style="display:none;">
    <div class="flex flex-col sm:flex-row items-start gap-6">
        <div class="flex-shrink-0 text-center sm:text-left">
            <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/vernon/kpoppapi.jpg") : assetBase + "/images/vernon/kpoppapi.jpg")"
                 class="w-32 h-32 rounded-full object-cover mx-auto sm:mx-0" alt="Profile" />
            <h4 class="font-bold text-xl mt-2 dark:text-white">Vernon</h4>
            <p class="text-sm text-slate-500 dark:text-slate-400">SEVENTEEN / Hip-Hop Team</p>
        </div>
        <div class="flex-1 w-full">
            <h2 class="section-title dark:text-white mb-4">Profile & Facts</h2>
            <ul class="divide-y divide-slate-100 dark:divide-slate-800">
                @foreach (var fact in Model.FunFacts)
                {
                    <li class="fact-item flex items-start gap-2 text-slate-700 dark:text-slate-300">
                        <span class="text-indigo-500 dark:text-indigo-400 mt-1">•</span>
                        <span>@fact</span>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="mt-6 text-right">
        <button class="modal-close-btn text-sm text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300">Close</button>
    </div>
</div>

<!-- Gallery Modal -->
<div id="galleryModal" style="display:none;">
    <div class="text-center mb-6">
        <h2 class="section-title dark:text-white">✨ Happy Vibes Collection</h2>
        <p class="text-slate-500 dark:text-slate-400 max-w-md mx-auto mt-2">Vernon's best moments</p>
    </div>
    <div class="gallery-grid">
        @for (int i = 1; i <= 15; i++)
        {
            <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content($"~/images/vernon/vernon{i}.jpg") : assetBase + $"/images/vernon/vernon{i}.jpg")"
                 class="gallery-img"
                 alt="Vernon @i"
                 onerror="this.style.display='none'" />
        }
    </div>
    <div class="mt-6 text-right">
        <button class="modal-close-btn text-sm text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300">Close</button>
    </div>
</div>

<!-- Messages Modal -->
<div id="messagesModal" style="display:none;">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
        <h2 class="section-title dark:text-white">Fan Messages</h2>
        <div class="flex gap-2">
            <button class="tab-btn active-tab" data-tab="read-tab">Read</button>
            <button class="tab-btn" data-tab="post-tab">Post</button>
        </div>
    </div>

    <div id="read-tab" class="tab-pane active">
        <div style="max-height:50vh; overflow-y:auto;">
            @if (Model.Messages.Any())
            {
                foreach (var msg in Model.Messages)
                {
                    <div class="message-card dark:bg-slate-800 dark:border-indigo-400">
                        <div class="flex items-start gap-3">
                            <div class="w-10 h-10 rounded-full bg-indigo-100 dark:bg-indigo-900 flex items-center justify-center text-indigo-600 dark:text-indigo-300 font-bold text-sm flex-shrink-0">
                                @msg.SenderName.Substring(0,1).ToUpper()
                            </div>
                            <div>
                                <p class="text-slate-800 dark:text-slate-100">"@msg.MessageContent"</p>
                                <span class="text-sm text-slate-500 dark:text-slate-400">— @msg.SenderName</span>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-center text-slate-400 dark:text-slate-500 py-8">No messages yet. Be the first!</p>
            }
        </div>
    </div>

    <div id="post-tab" class="tab-pane" style="display:none;">
        <form action="/Home/PostMessage" method="post" class="mt-4" id="messageForm">
            @Html.AntiForgeryToken()
            <div class="mb-4">
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1">Your Name</label>
                <input type="text" name="sender" class="input-clean" maxlength="30" required />
            </div>
            <div class="mb-4">
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1">Your Message</label>
                <textarea name="content" rows="4" class="input-clean" maxlength="500" required></textarea>
                <p class="text-xs text-slate-400 dark:text-slate-500 mt-1 text-right"><span id="charCount">0</span>/500</p>
            </div>
            <button type="submit" class="btn-primary w-full">Send Message</button>
        </form>
    </div>

    <div class="mt-4 text-right">
        <button class="modal-close-btn text-sm text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300">Close</button>
    </div>
</div>

<!-- Discography Modal -->
<div id="discographyModal" style="display:none;">
    <h2 class="section-title dark:text-white mb-6">Discography</h2>
    <div style="max-height:60vh; overflow-y:auto;">

        <h4 class="font-bold text-xl border-b border-slate-200 dark:border-slate-700 pb-2 mb-4 dark:text-white">2024</h4>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 mb-8">
            <div>
                <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/17isrighthere.jpg") : assetBase + "/images/albums/17isrighthere.jpg")"
                     class="w-full rounded-xl shadow-sm hover:shadow-md transition" alt="17 Is Right Here" onerror="this.src='https://placehold.co/300x300?text=17+Is+Right+Here'" />
                <p class="font-bold mt-2 dark:text-white">17 Is Right Here</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">Best Album</p>
            </div>
            <div>
                <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/spillthefeels.jpg") : assetBase + "/images/albums/spillthefeels.jpg")"
                     class="w-full rounded-xl shadow-sm hover:shadow-md transition" alt="Spill The Feels" onerror="this.src='https://placehold.co/300x300?text=Spill+The+Feels'" />
                <p class="font-bold mt-2 dark:text-white">Spill The Feels</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">12th Mini Album</p>
            </div>
            <div>
                <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/shohikigen.jpg") : assetBase + "/images/albums/shohikigen.jpg")"
                     class="w-full rounded-xl shadow-sm hover:shadow-md transition" alt="Shohikigen" onerror="this.src='https://placehold.co/300x300?text=Shohikigen'" />
                <p class="font-bold mt-2 dark:text-white">Shohikigen</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">JP Single</p>
            </div>
        </div>

        <h4 class="font-bold text-xl border-b border-slate-200 dark:border-slate-700 pb-2 mb-4 dark:text-white">2023</h4>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 mb-8">
            <div>
                <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/fml.jpg") : assetBase + "/images/albums/fml.jpg")"
                     class="w-full rounded-xl shadow-sm hover:shadow-md transition" alt="FML" onerror="this.src='https://placehold.co/300x300?text=FML'" />
                <p class="font-bold mt-2 dark:text-white">FML</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">10th Mini Album</p>
            </div>
            <div>
                <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/seventeenthheaven.jpg") : assetBase + "/images/albums/seventeenthheaven.jpg")"
                     class="w-full rounded-xl shadow-sm hover:shadow-md transition" alt="Seventeenth Heaven" onerror="this.src='https://placehold.co/300x300?text=Seventeenth+Heaven'" />
                <p class="font-bold mt-2 dark:text-white">Seventeenth Heaven</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">11th Mini Album</p>
            </div>
        </div>

        <h4 class="font-bold text-xl border-b border-slate-200 dark:border-slate-700 pb-2 mb-4 dark:text-white">2015</h4>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-6">
            <div>
                <img src="@(string.IsNullOrEmpty(assetBase) ? Url.Content("~/images/albums/17carat.jpg") : assetBase + "/images/albums/17carat.jpg")"
                     class="w-full rounded-xl shadow-sm hover:shadow-md transition" alt="17 Carat" onerror="this.src='https://placehold.co/300x300?text=17+Carat'" />
                <p class="font-bold mt-2 dark:text-white">17 Carat</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">1st Mini Album</p>
            </div>
        </div>
    </div>
    <div class="mt-6 text-right">
        <button class="modal-close-btn text-sm text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300">Close</button>
    </div>
</div>

<!-- ===== SCRIPTS ===== -->
<script>
    // ── COUNTDOWN ──
    document.addEventListener('DOMContentLoaded', function() {
        const target = new Date('February 18, 2027 00:00:00').getTime();
        function update() {
            const now = Date.now();
            const diff = target - now;
            if (diff < 0) {
                ['days','hours','minutes','seconds'].forEach(id => document.getElementById(id).textContent = '🎉');
                return;
            }
            document.getElementById('days').textContent = String(Math.floor(diff / (1000*60*60*24))).padStart(2, '0');
            document.getElementById('hours').textContent = String(Math.floor((diff % (1000*60*60*24)) / (1000*60*60))).padStart(2, '0');
            document.getElementById('minutes').textContent = String(Math.floor((diff % (1000*60*60)) / (1000*60))).padStart(2, '0');
            document.getElementById('seconds').textContent = String(Math.floor((diff % (1000*60)) / 1000)).padStart(2, '0');
        }
        update(); setInterval(update, 1000);
    });

    // ── TAB SWITCHING ──
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const tabId = this.dataset.tab;
                const parent = this.closest('.modal-content');
                if (!parent) return;
                parent.querySelectorAll('.tab-pane').forEach(pane => pane.style.display = 'none');
                parent.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active-tab'));
                document.getElementById(tabId).style.display = 'block';
                this.classList.add('active-tab');
            });
        });
    });

    // ── CHARACTER COUNTER ──
    document.addEventListener('DOMContentLoaded', function() {
        const textarea = document.querySelector('textarea[name="content"]');
        if (textarea) {
            textarea.addEventListener('input', function() {
                document.getElementById('charCount').textContent = this.value.length;
            });
        }
    });

    // ── CLIENT-SIDE PROFANITY FILTER ──
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('messageForm');
        if (form) {
            form.addEventListener('submit', function(e) {
                const content = this.querySelector('textarea[name="content"]').value.toLowerCase();
                const badWords = ['fuck', 'shit', 'ass', 'bitch', 'cunt', 'whore', 'slut', 'bastard', 'idiot', 'stupid', 'hate', 'kill', 'die', 'racist', 'nazi', 'hitler', 'suicide', 'selfharm'];
                if (badWords.some(w => content.includes(w))) {
                    e.preventDefault();
                    showToast('Please remove inappropriate language.');
                }
            });
        }
    });
</script>
